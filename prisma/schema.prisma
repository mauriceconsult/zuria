generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Shop {
  id             String          @id @default(uuid())
  name           String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  userId         String
  address        String?
  latitude       Float?
  longitude      Float?
  country        String          @default("UG")
  currency       String          @default("UGX")
  momoPhone      String?
  phone          String?
  billboards     Billboard[]     @relation("ShopToBillboard")
  categories     Category[]      @relation("ShopToCategory")
  colors         Color[]         @relation("ShopToColor")
  orders         Order[]         @relation("ShopToOrder")
  products       Product[]       @relation("ShopToProduct")
  refundRequests RefundRequest[] @relation("ShopToRefundRequest")
  sizes          Size[]          @relation("ShopToSize")

  @@index([userId])
}

model Billboard {
  id         String     @id @default(uuid())
  shopId     String
  label      String
  imageUrl   String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  shop       Shop       @relation("ShopToBillboard", fields: [shopId], references: [id])
  categories Category[]

  @@index([shopId])
}
enum VehicleType {
  motorcycle
  bicycle
  car
  // van
  // truck
}

model Category {
  id          String    @id @default(uuid())
  shopId      String
  billboardId String
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  billboard   Billboard @relation(fields: [billboardId], references: [id])
  shop        Shop      @relation("ShopToCategory", fields: [shopId], references: [id])
  products    Product[] @relation("CategoryToProduct")

  @@index([shopId])
  @@index([billboardId])
}

model Size {
  id        String    @id @default(uuid())
  shopId    String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  value     String
  products  Product[]
  shop      Shop      @relation("ShopToSize", fields: [shopId], references: [id])

  @@index([shopId])
}

model Color {
  id        String    @id @default(uuid())
  shopId    String
  name      String
  value     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  shop      Shop      @relation("ShopToColor", fields: [shopId], references: [id])
  products  Product[]

  @@index([shopId])
}

model Product {
  id         String      @id @default(uuid())
  shopId     String
  categoryId String
  name       String
  price      Decimal
  isFeatured Boolean     @default(false)
  isArchived Boolean     @default(false)
  sizeId     String
  colorId    String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  images     Image[]
  orderItems OrderItem[]
  category   Category    @relation("CategoryToProduct", fields: [categoryId], references: [id])
  color      Color       @relation(fields: [colorId], references: [id])
  shop       Shop        @relation("ShopToProduct", fields: [shopId], references: [id])
  size       Size        @relation(fields: [sizeId], references: [id])

  @@index([shopId])
  @@index([categoryId])
  @@index([sizeId])
  @@index([colorId])
}

model Image {
  id        String   @id @default(uuid())
  productId String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id                  String         @id @default(uuid())
  shopId              String
  isPaid              Boolean        @default(false)
  phone               String         @default("")
  address             String         @default("")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deliveryCost        Decimal?
  deliveryMethod      String?
  deliveryRef         String?
  deliveryStatus      String         @default("pending")
  paymentMethod       String         @default("stripe")
  paymentRef          String?
  paymentStatus       String         @default("pending")
  platformFee         Decimal?
  shopPayout          Decimal?
  deliveryProvider    String?
  deliveryTrackingUrl String?
  deliveryQuoteId     String?
  deliveredAt         DateTime?
  deliveryLat         Float?
  deliveryLng         Float?
  jobs                DeliveryJob?
  shop                Shop           @relation("ShopToOrder", fields: [shopId], references: [id])
  orderItems          OrderItem[]
  refundRequest       RefundRequest?

  @@index([shopId])
}

model RefundRequest {
  id             String    @id @default(uuid())
  orderId        String    @unique
  shopId         String
  buyerPhone     String
  buyerEmail     String?
  reason         String
  evidence       String[]
  status         String    @default("pending")
  sellerResponse String?
  adminNotes     String?
  requestedAt    DateTime  @default(now())
  resolvedAt     DateTime?
  refundedAt     DateTime?
  expiresAt      DateTime
  order          Order     @relation(fields: [orderId], references: [id])
  shop           Shop      @relation("ShopToRefundRequest", fields: [shopId], references: [id])

  @@index([shopId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Rider {
  id          String         @id @default(uuid())
  clerkId     String         @unique
  name        String
  phone       String
  email       String

  vehicleType VehicleType    @default(motorcycle)

  isActive    Boolean        @default(true)
  rating      Float          @default(5.0)
  totalJobs   Int            @default(0)

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  jobs        DeliveryJob[]
}

model DeliveryJob {
  id           String    @id @default(uuid())
  orderId      String    @unique
  riderId      String?
  status       String    @default("pending")
  deliveryCost Float     @default(0)
  lastLat      Float?
  lastLng      Float?
  acceptedAt   DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  order        Order     @relation(fields: [orderId], references: [id])
  rider        Rider?    @relation(fields: [riderId], references: [id])

  @@index([status])
  @@index([riderId])
}
