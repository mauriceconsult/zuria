generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Shop {
  id             String          @id @default(uuid())
  name           String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  userId         String
  address        String?
  latitude       Float?
  longitude      Float?
  country        String          @default("UG")
  currency       String          @default("UGX")
  momoPhone      String?
  phone          String?
  billboards     Billboard[]     @relation("ShopToBillboard")
  categories     Category[]      @relation("ShopToCategory")
  colors         Color[]         @relation("ShopToColor")
  orders         Order[]         @relation("ShopToOrder")
  products       Product[]       @relation("ShopToProduct")
  refundRequests RefundRequest[] @relation("ShopToRefundRequest")
  sizes          Size[]          @relation("ShopToSize")
  deliveryJobs DeliveryJob[]

  @@index([userId])
}

model Billboard {
  id         String     @id @default(uuid())
  shopId     String
  label      String
  imageUrl   String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  shop       Shop       @relation("ShopToBillboard", fields: [shopId], references: [id])
  categories Category[]

  @@index([shopId])
}
enum VehicleType {
  motorcycle
  bicycle
  car
  // van
  // truck
}

model Category {
  id          String    @id @default(uuid())
  shopId      String
  billboardId String
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  billboard   Billboard @relation(fields: [billboardId], references: [id])
  shop        Shop      @relation("ShopToCategory", fields: [shopId], references: [id])
  products    Product[] @relation("CategoryToProduct")

  @@index([shopId])
  @@index([billboardId])
}

model Size {
  id        String    @id @default(uuid())
  shopId    String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  value     String
  products  Product[]
  shop      Shop      @relation("ShopToSize", fields: [shopId], references: [id])

  @@index([shopId])
}

model Color {
  id        String    @id @default(uuid())
  shopId    String
  name      String
  value     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  shop      Shop      @relation("ShopToColor", fields: [shopId], references: [id])
  products  Product[]

  @@index([shopId])
}

model Product {
  id         String      @id @default(uuid())
  shopId     String
  categoryId String
  name       String
  price      Decimal
  isFeatured Boolean     @default(false)
  isArchived Boolean     @default(false)
  sizeId     String
  colorId    String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  images     Image[]
  orderItems OrderItem[]
  category   Category    @relation("CategoryToProduct", fields: [categoryId], references: [id])
  color      Color       @relation(fields: [colorId], references: [id])
  shop       Shop        @relation("ShopToProduct", fields: [shopId], references: [id])
  size       Size        @relation(fields: [sizeId], references: [id])

  @@index([shopId])
  @@index([categoryId])
  @@index([sizeId])
  @@index([colorId])
}

model Image {
  id        String   @id @default(uuid())
  productId String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id                  String         @id @default(uuid())

  shopId              String

  isPaid              Boolean        @default(false)

  paymentMethod       String         @default("stripe")
  paymentStatus       String         @default("pending")
  paymentRef          String?

  deliveryMethod      String?
  deliveryProvider    String?
  deliveryQuoteId     String?
  deliveryRef         String?
  deliveryStatus      String         @default("pending")
  deliveryTrackingUrl String?

  deliveryCost        Decimal?
  platformFee         Decimal?
  shopPayout          Decimal?
  riderPayout         Decimal?

  shopPayoutStatus    String         @default("not_applicable")
  riderPayoutStatus   String         @default("not_applicable")

  phone               String         @default("")
  address             String         @default("")
  deliveryLat         Float?
  deliveryLng         Float?
  deliveredAt         DateTime?

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  shop                Shop           @relation("ShopToOrder", fields: [shopId], references: [id])
  jobs                DeliveryJob?
  orderItems          OrderItem[]
  disbursements Disbursement[]
  refundRequest       RefundRequest?

  @@index([shopId])
}
model Disbursement {
  id              String   @id @default(uuid())

  orderId         String
  order           Order    @relation(fields: [orderId], references: [id])

  recipientType   String   // "shop" | "rider"

  phone           String

  amount          Decimal
  currency        String

  momoReferenceId String   @unique

  momoStatus      String   @default("PROCESSING")
  failureReason   String?

  completedAt     DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orderId])
  @@index([momoStatus])
  @@index([recipientType])
}

model RefundRequest {
  id             String    @id @default(uuid())
  orderId        String    @unique
  shopId         String
  buyerPhone     String
  buyerEmail     String?
  reason         String
  evidence       String[]
  status         String    @default("pending")
  sellerResponse String?
  adminNotes     String?
  requestedAt    DateTime  @default(now())
  resolvedAt     DateTime?
  refundedAt     DateTime?
  expiresAt      DateTime
  order          Order     @relation(fields: [orderId], references: [id])
  shop           Shop      @relation("ShopToRefundRequest", fields: [shopId], references: [id])

  @@index([shopId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

enum RiderApprovalSource {
  shop
  platform
}

model Rider {
  id            String               @id @default(uuid())
  clerkId       String               @unique
  name          String
  phone         String
  email         String

  vehicleType   VehicleType          @default(motorcycle)

  isActive      Boolean              @default(true)

  isApproved    Boolean              @default(false)
  approvedBy    RiderApprovalSource?
  approvedById  String?
  approvedAt    DateTime?

  rating        Float                @default(5.0)

  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  jobs          DeliveryJob[]
}

model DeliveryJob {
  id           String      @id @default(uuid())
  orderId      String      @unique
  shopId       String
  riderId      String?

  vehicleType  VehicleType?

  status       String      @default("pending")
  deliveryCost Float       @default(0)

  lastLat      Float?
  lastLng      Float?

  acceptedAt   DateTime?
  deliveredAt  DateTime?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  shops Shop[]

  order         Order      @relation(fields: [orderId], references: [id])
  rider         Rider?     @relation(fields: [riderId], references: [id])

  @@index([status])
  @@index([riderId])
  @@index([vehicleType])
}
